{
  "manifest_version": 3,
  "name": "Tablight \u2014 jump to a tab",
  "version": "0.2.4",
  "description": "Type a few letters. Return to your tab. A private, Arc-inspired command palette.",
  "minimum_chrome_version": "127",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "search",
    "favicon"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Tablight",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "Command+Shift+Space"
      }
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["palette.html"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "options_ui": {
    "page": "setup.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
